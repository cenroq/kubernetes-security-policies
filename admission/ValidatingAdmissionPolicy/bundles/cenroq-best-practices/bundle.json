    "version": "v0.3.0",
    "deployment": "mkdir -p /tmp/cenroq && curl -L https://github.com/cenroq/kubernetes-security-policies/releases/download/vap_cenroq-best-practices%40v0.3.0/cenroq-best-practices_v0.3.0.tar.gz | tar -xz -C /tmp/cenroq && kubectl apply -f /tmp/cenroq/cenroq-best-practices/policies.yaml -f /tmp/cenroq/cenroq-best-practices/bindings.yaml",
