    "version": "v1.37.0",
    "deployment": "mkdir -p /tmp/cenroq && curl -L https://github.com/cenroq/kubernetes-security-policies/releases/download/vap_pod-security-admission%40v1.37.0/pod-security-admission_v1.37.0.tar.gz | tar -xz -C /tmp/cenroq && kubectl apply -f /tmp/cenroq/pod-security-admission/policies.yaml -f /tmp/cenroq/pod-security-admission/bindings.yaml",
    "labels": {
        "warn": "pss.security.cenroq.io/warn",
